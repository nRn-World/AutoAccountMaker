{
  "manifest_version": 3,
  "name": "AutoAccountMaker",
  "version": "1.12.0",
  "description": "Creates accounts automatically with a temporary e mail address, verifies them and logs in for you.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "unlimitedStorage",
    "tabs",
    "windows",
    "sidePanel"
  ],
  "host_permissions": [
    "https://api.mail.tm/*",
    "https://privatix-temp-mail-v1.p.rapidapi.com/*",
    "http://*/*",
    "https://*/*"
  ],
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
